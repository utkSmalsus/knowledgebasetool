# SharePoint connectivity — see SHAREPOINT.md for the full setup walkthrough.
# Copy this file to .env.local (git-ignored by default in a normal Vite setup)
# and fill in real values. Leave unset to keep using local-only storage.

# 'msal' (Azure AD sign-in, works hosted anywhere — the only mode that works
# from localhost) or 'traditional' (cookie-based, only works served from an
# origin SharePoint trusts). Defaults to 'traditional' when unset.
VITE_SP_AUTH_MODE=msal

# e.g. https://yourtenant.sharepoint.com/sites/yoursite — no trailing slash.
VITE_SP_SITE_URL=

# Display name of the SharePoint list that stores knowledge entries.
VITE_SP_LIST_NAME=knowledgebase

# --- 'msal' mode only ---
VITE_MSAL_CLIENT_ID=
VITE_MSAL_TENANT_ID=common
VITE_MSAL_REDIRECT_URI=
